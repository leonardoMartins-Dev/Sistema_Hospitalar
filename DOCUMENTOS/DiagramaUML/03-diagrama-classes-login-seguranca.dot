digraph G {
  rankdir=TB; splines=true; nodesep=0.55; ranksep=0.9; pad=0.4;
  labelloc=t; fontsize=24; fontname="DejaVu Sans"; label=<<B>MedVita — Diagrama de Classes: Login, Segurança e Infraestrutura</B>>;
  node [fontname="DejaVu Sans" fontsize=12];
  edge [fontname="DejaVu Sans" fontsize=11 color="#333333" labeldistance=2.2];
  ranksep=1.0; nodesep=0.5;
App [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«SpringBootApplication»<BR/><B>TelaLoginApplication</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+main(args: String[])  {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Login [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Controller»<BR/><B>SecureLoginController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-userConfig: UserConfig<BR ALIGN="LEFT"/>-sendEmailService: SendEmailService<BR ALIGN="LEFT"/>-pacienteService: PacienteService<BR ALIGN="LEFT"/>-passwordRecoveryService: PasswordRecoveryService<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+home(authentication, model): String<BR ALIGN="LEFT"/>+login(model): String<BR ALIGN="LEFT"/>+error(): String<BR ALIGN="LEFT"/>+admin(authentication, model): String<BR ALIGN="LEFT"/>+medico(authentication, model): String<BR ALIGN="LEFT"/>+register(): String<BR ALIGN="LEFT"/>+handleRegister(nome, email, cpf, endereco, telefone, dataNascimento, senha): String<BR ALIGN="LEFT"/>+recoverpassword(): String<BR ALIGN="LEFT"/>+handleRecoverPassword(email): String<BR ALIGN="LEFT"/>+resetPassword(token, model): String<BR ALIGN="LEFT"/>+handleResetPassword(token, senha, confirmarSenha): String<BR ALIGN="LEFT"/>+10 métodos GET das páginas de paciente, médico e admin<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Sec [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Configuration · EnableWebSecurity»<BR/><B>SecurityConfig</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-recaptchaFilter: RecaptchaFilter<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+securityFilterChain(http: HttpSecurity): SecurityFilterChain<BR ALIGN="LEFT"/>+passwordEncoder(): PasswordEncoder<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Filter [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6"><B>RecaptchaFilter</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-recaptchaService: RecaptchaService<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">#doFilterInternal(request, response, filterChain)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
OPRF [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F1F1F1" COLOR="#777777" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«abstract»<BR/><B>OncePerRequestFilter</B></TD></TR></TABLE>>];
Recaptcha [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>RecaptchaService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-userConfig: UserConfig<BR ALIGN="LEFT"/>-httpClient: HttpClient<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+validate(captchaResponse: String): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
UserCfg [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Configuration»<BR/><B>UserConfig</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-adminUsername / -adminPassword / -adminName<BR ALIGN="LEFT"/>-pacienteTesteUsername / -pacienteTestePassword<BR ALIGN="LEFT"/>-medicoTesteUsername / -medicoTestePassword<BR ALIGN="LEFT"/>-recaptchaSiteKey / -recaptchaSecretKey<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getters (um para cada atributo)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
DbUser [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>DatabaseUserDetailsService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pacienteService: PacienteService<BR ALIGN="LEFT"/>-adminUsername: String<BR ALIGN="LEFT"/>-adminPasswordHash: String<BR ALIGN="LEFT"/>-pacienteTesteUsername / -pacienteTestePasswordHash<BR ALIGN="LEFT"/>-medicoTesteUsername / -medicoTestePasswordHash<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+loadUserByUsername(username: String): UserDetails<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
UDS [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F1F1F1" COLOR="#777777" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>UserDetailsService</B></TD></TR></TABLE>>];
PwdEnc [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F1F1F1" COLOR="#777777" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface · BCrypt»<BR/><B>PasswordEncoder</B></TD></TR></TABLE>>];
PacSvc [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>PacienteService</B><BR/><FONT POINT-SIZE="10">(detalhado no diagrama 02)</FONT></TD></TR></TABLE>>];
Recovery [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>PasswordRecoveryService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-tokens: Map&lt;String, RecoveryToken&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+generateToken(email: String): String<BR ALIGN="LEFT"/>+getEmailFromToken(token: String): String<BR ALIGN="LEFT"/>+invalidateToken(token: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Token [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«record · private»<BR/><B>RecoveryToken</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">email: String<BR ALIGN="LEFT"/>expiration: LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Mail [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>SendEmailService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-mailSender: JavaMailSender<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+sendEmail(to: String, subject: String, body: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
JMS [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F1F1F1" COLOR="#777777" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>JavaMailSender</B></TD></TR></TABLE>>];
Login -> UserCfg [arrowhead=vee];
Login -> Mail [arrowhead=vee];
Login -> PacSvc [arrowhead=vee];
Login -> Recovery [arrowhead=vee];
Sec -> Filter [dir=both arrowtail=diamond arrowhead=vee];
