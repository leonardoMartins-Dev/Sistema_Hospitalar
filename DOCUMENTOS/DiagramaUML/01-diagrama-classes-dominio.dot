digraph G {
  rankdir=TB; splines=true; nodesep=0.55; ranksep=0.9; pad=0.4;
  labelloc=t; fontsize=24; fontname="DejaVu Sans"; label=<<B>MedVita — Diagrama de Classes: Domínio</B>>;
  node [fontname="DejaVu Sans" fontsize=12];
  edge [fontname="DejaVu Sans" fontsize=11 color="#333333" labeldistance=2.2];
  
Paciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tabela pacientes»<BR/><B>Paciente</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-email: String<BR ALIGN="LEFT"/>-passwordHash: String<BR ALIGN="LEFT"/>-nome: String<BR ALIGN="LEFT"/>-cpf: String<BR ALIGN="LEFT"/>-telefone: String<BR ALIGN="LEFT"/>-endereco: String<BR ALIGN="LEFT"/>-dataNascimento: LocalDate<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Paciente()<BR ALIGN="LEFT"/>+Paciente(email: String, passwordHash: String, nome: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Profissional [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tabela profissionais_saude»<BR/><B>ProfissionalSaude</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-nome: String<BR ALIGN="LEFT"/>-registroProfissional: String<BR ALIGN="LEFT"/>-especialidade: String<BR ALIGN="LEFT"/>-telefone: String<BR ALIGN="LEFT"/>-email: String<BR ALIGN="LEFT"/>-passwordHash: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Quarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tabela quartos»<BR/><B>Quarto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-numero: String<BR ALIGN="LEFT"/>-andar: int<BR ALIGN="LEFT"/>-capacidadeMaxima: int<BR ALIGN="LEFT"/>-ocupacaoAtual: int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getSituacao(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Consulta [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tabela consultas»<BR/><B>Consulta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-paciente: Paciente<BR ALIGN="LEFT"/>-profissional: ProfissionalSaude<BR ALIGN="LEFT"/>-data: LocalDate<BR ALIGN="LEFT"/>-horario: LocalTime<BR ALIGN="LEFT"/>-motivo: String<BR ALIGN="LEFT"/>-observacoes: String<BR ALIGN="LEFT"/>-status: String   «AGENDADA | REALIZADA | CANCELADA»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Internacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tabela internacoes»<BR/><B>Internacao</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-paciente: Paciente<BR ALIGN="LEFT"/>-profissional: ProfissionalSaude<BR ALIGN="LEFT"/>-quarto: Quarto<BR ALIGN="LEFT"/>-dataEntrada: LocalDate<BR ALIGN="LEFT"/>-dataPrevistaAlta: LocalDate<BR ALIGN="LEFT"/>-dataEfetivaAlta: LocalDate<BR ALIGN="LEFT"/>-observacoes: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+estaInternado(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Historico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«não persistida (sem @Entity)»<BR/><B>HistoricoMedico</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-paciente: Paciente<BR ALIGN="LEFT"/>-consultas: List&lt;Consulta&gt;<BR ALIGN="LEFT"/>-internacoes: List&lt;Internacao&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
{rank=same; Paciente; Profissional; Quarto;}
{rank=same; Consulta; Internacao;}
Paciente -> Profissional -> Quarto [style=invis];
Consulta -> Internacao [style=invis];
Paciente -> Consulta [arrowhead=vee taillabel="1" headlabel="0..*" dir=back arrowtail=vee arrowhead=none];
Profissional -> Consulta [arrowhead=vee taillabel="1" headlabel="0..*" dir=back arrowtail=vee arrowhead=none];
Paciente -> Internacao [arrowhead=vee taillabel="1" headlabel="0..*" dir=back arrowtail=vee arrowhead=none];
Profissional -> Internacao [arrowhead=vee label=<responsável> taillabel="1" headlabel="0..*" dir=back arrowtail=vee arrowhead=none];
Quarto -> Internacao [arrowhead=vee label=<ocupa> taillabel="1" headlabel="0..*" dir=back arrowtail=vee arrowhead=none];
Consulta -> Historico [arrowhead=odiamond label=<só REALIZADAS> taillabel="0..*"];
Internacao -> Historico [arrowhead=odiamond taillabel="0..*"];
Paciente -> Historico [arrowhead=odiamond taillabel="1" constraint=false];
legend [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legenda</B></TD></TR><TR><TD WIDTH="26" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid" BORDER="1"> </TD><TD ALIGN="LEFT">Classe implementada no código</TD></TR><TR><TD WIDTH="26" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed" BORDER="1"> </TD><TD ALIGN="LEFT">Classe só documentada no código (a implementar)</TD></TR><TR><TD WIDTH="26" BGCOLOR="#F1F1F1" COLOR="#777777" STYLE="solid" BORDER="1"> </TD><TD ALIGN="LEFT">Classe/interface de framework (Spring, JDK)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Getters e setters omitidos.</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Associações com @ManyToOne partem de Consulta e Internacao (coluna *_id).</TD></TR></TABLE>>];
}
