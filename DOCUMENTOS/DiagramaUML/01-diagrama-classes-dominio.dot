digraph G {
  rankdir=TB; splines=true; nodesep=0.55; ranksep=0.9; pad=0.4;
  labelloc=t; fontsize=24; fontname="Helvetica"; label=<<B>MedVita — Diagrama de Classes: Domínio (Sprint 2)</B>>;
  node [fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=11 color="#333333" labeldistance=2.2];
Prof [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«abstract · Entity · tabela profissionais_saude»<BR/><B><I>ProfissionalSaude</I></B><BR/><FONT POINT-SIZE="10">SINGLE_TABLE · discriminador: tipo</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-nome: String<BR ALIGN="LEFT"/>-registroProfissional: String<BR ALIGN="LEFT"/>-telefone: String<BR ALIGN="LEFT"/>-email: String<BR ALIGN="LEFT"/>-passwordHash: String  {JsonIgnore}<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getCategoria(): CategoriaProfissional  {abstract}<BR ALIGN="LEFT"/>+getAreaAtuacao(): String  {abstract}<BR ALIGN="LEFT"/>+podeRealizar(a: Atendimento): boolean  {abstract}<BR ALIGN="LEFT"/>+verificarSePodeRealizar(a: Atendimento)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Clinico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tipo = CLINICO_GERAL»<BR/><B>MedicoClinicoGeral</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getCategoria(): CategoriaProfissional<BR ALIGN="LEFT"/>+getAreaAtuacao(): String<BR ALIGN="LEFT"/>+podeRealizar(a): boolean   rotina ou emergência<BR ALIGN="LEFT"/>+encaminhar(c: ConsultaRotina, e: Especialidade)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Especialista [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tipo = ESPECIALISTA»<BR/><B>MedicoEspecialista</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-especialidade: Especialidade<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getCategoria(): CategoriaProfissional<BR ALIGN="LEFT"/>+getAreaAtuacao(): String<BR ALIGN="LEFT"/>+podeRealizar(a): boolean   especializada da<BR ALIGN="LEFT"/>      mesma especialidade ou emergência<BR ALIGN="LEFT"/>+atendeEspecialidade(e: Especialidade): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Cirurgiao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tipo = CIRURGIAO»<BR/><B>Cirurgiao</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-areaCirurgica: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getCategoria(): CategoriaProfissional<BR ALIGN="LEFT"/>+getAreaAtuacao(): String<BR ALIGN="LEFT"/>+podeRealizar(a): boolean   procedimento cirúrgico<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Paciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tabela pacientes»<BR/><B>Paciente</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-email: String<BR ALIGN="LEFT"/>-passwordHash: String<BR ALIGN="LEFT"/>-nome: String<BR ALIGN="LEFT"/>-cpf: String<BR ALIGN="LEFT"/>-telefone: String<BR ALIGN="LEFT"/>-endereco: String<BR ALIGN="LEFT"/>-dataNascimento: LocalDate<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+Paciente()<BR ALIGN="LEFT"/>+Paciente(email, passwordHash, nome)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Atend [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«abstract · Entity · tabela atendimentos»<BR/><B><I>Atendimento</I></B><BR/><FONT POINT-SIZE="10">SINGLE_TABLE · discriminador: tipo</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-paciente: Paciente<BR ALIGN="LEFT"/>-profissional: ProfissionalSaude<BR ALIGN="LEFT"/>-data: LocalDate<BR ALIGN="LEFT"/>-horario: LocalTime<BR ALIGN="LEFT"/>-motivo: String<BR ALIGN="LEFT"/>-observacoes: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+validar()  {final}   regras comuns + da modalidade<BR ALIGN="LEFT"/>#validarRegrasDaModalidade()  {abstract}<BR ALIGN="LEFT"/>#verificarProfissional()<BR ALIGN="LEFT"/>#verificarDataFutura()<BR ALIGN="LEFT"/>+getTipo(): TipoAtendimento  {abstract}<BR ALIGN="LEFT"/>+iniciar()  {abstract}<BR ALIGN="LEFT"/>+concluir(observacoes: String)  {abstract}<BR ALIGN="LEFT"/>+cancelar()  {abstract}<BR ALIGN="LEFT"/>+ocupaAgenda(): boolean  {abstract}<BR ALIGN="LEFT"/>+isConcluido(): boolean  {abstract}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Consulta [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«abstract · Entity»<BR/><B><I>Consulta</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-status: StatusConsulta<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+confirmar()<BR ALIGN="LEFT"/>+iniciar()<BR ALIGN="LEFT"/>+concluir(observacoes: String)<BR ALIGN="LEFT"/>+cancelar()<BR ALIGN="LEFT"/>+registrarNaoComparecimento()<BR ALIGN="LEFT"/>+reagendar(data, horario): Consulta<BR ALIGN="LEFT"/>#copiar(): Consulta  {abstract}<BR ALIGN="LEFT"/>-mudarStatus(novo: StatusConsulta)<BR ALIGN="LEFT"/>+ocupaAgenda(): boolean<BR ALIGN="LEFT"/>+isConcluido(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Rotina [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tipo = ROTINA»<BR/><B>ConsultaRotina</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-encaminhamento: Especialidade<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getTipo(): TipoAtendimento<BR ALIGN="LEFT"/>#validarRegrasDaModalidade()<BR ALIGN="LEFT"/>+registrarEncaminhamento(e: Especialidade)<BR ALIGN="LEFT"/>#copiar(): Consulta<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Especializada [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tipo = ESPECIALIZADA»<BR/><B>ConsultaEspecializada</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-especialidade: Especialidade<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getTipo(): TipoAtendimento<BR ALIGN="LEFT"/>#validarRegrasDaModalidade()<BR ALIGN="LEFT"/>#copiar(): Consulta<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Emerg [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tipo = EMERGENCIA»<BR/><B>AtendimentoEmergencia</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-prioridade: Prioridade<BR ALIGN="LEFT"/>-status: StatusEmergencia<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getTipo(): TipoAtendimento<BR ALIGN="LEFT"/>#validarRegrasDaModalidade()<BR ALIGN="LEFT"/>+atribuirProfissional(p: ProfissionalSaude)<BR ALIGN="LEFT"/>+iniciar()<BR ALIGN="LEFT"/>+concluir(observacoes: String)<BR ALIGN="LEFT"/>+cancelar()   sempre lança exceção<BR ALIGN="LEFT"/>+ocupaAgenda(): boolean   sempre false<BR ALIGN="LEFT"/>+isConcluido(): boolean<BR ALIGN="LEFT"/>+aguardandoAvaliacao(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Cirurgia [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tipo = CIRURGIA»<BR/><B>ProcedimentoCirurgico</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-descricaoProcedimento: String<BR ALIGN="LEFT"/>-tipoCirurgia: TipoCirurgia<BR ALIGN="LEFT"/>-observacoesPreOperatorias: String<BR ALIGN="LEFT"/>-observacoesPosOperatorias: String<BR ALIGN="LEFT"/>-inicioEfetivo: LocalDateTime<BR ALIGN="LEFT"/>-fimEfetivo: LocalDateTime<BR ALIGN="LEFT"/>-status: StatusProcedimento<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getTipo(): TipoAtendimento<BR ALIGN="LEFT"/>#validarRegrasDaModalidade()<BR ALIGN="LEFT"/>+iniciar()<BR ALIGN="LEFT"/>+concluir(obsPos: String)   só se EM_ANDAMENTO<BR ALIGN="LEFT"/>+cancelar()   só se AGENDADO<BR ALIGN="LEFT"/>+ocupaAgenda(): boolean<BR ALIGN="LEFT"/>+isConcluido(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Quarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tabela quartos»<BR/><B>Quarto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-numero: String<BR ALIGN="LEFT"/>-andar: int<BR ALIGN="LEFT"/>-capacidadeMaxima: int<BR ALIGN="LEFT"/>-ocupacaoAtual: int<BR ALIGN="LEFT"/>-tipo: TipoQuarto<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+validar()<BR ALIGN="LEFT"/>+temVaga(): boolean<BR ALIGN="LEFT"/>+getLeitosLivres(): int<BR ALIGN="LEFT"/>+getSituacao(): String<BR ALIGN="LEFT"/>+ocupar()<BR ALIGN="LEFT"/>+liberar()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Internacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity · tabela internacoes»<BR/><B>Internacao</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: Long<BR ALIGN="LEFT"/>-paciente: Paciente<BR ALIGN="LEFT"/>-profissional: ProfissionalSaude<BR ALIGN="LEFT"/>-quarto: Quarto<BR ALIGN="LEFT"/>-dataEntrada: LocalDate<BR ALIGN="LEFT"/>-dataPrevistaAlta: LocalDate<BR ALIGN="LEFT"/>-dataEfetivaAlta: LocalDate<BR ALIGN="LEFT"/>-observacoes: String<BR ALIGN="LEFT"/>-status: StatusInternacao<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+validar()<BR ALIGN="LEFT"/>+estaInternado(): boolean<BR ALIGN="LEFT"/>+darAlta(dataEfetivaAlta: LocalDate, observacoes: String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Historico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«não persistida (sem @Entity)»<BR/><B>HistoricoMedico</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-paciente: Paciente<BR ALIGN="LEFT"/>-atendimentos: List&lt;Atendimento&gt;<BR ALIGN="LEFT"/>-internacoes: List&lt;Internacao&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+HistoricoMedico(paciente, atendimentos, internacoes)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Enums [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="8" CELLPADDING="0" COLOR="#3C7A3C" STYLE="rounded"><TR><TD COLSPAN="5" ALIGN="LEFT"><B>Enums</B>  (pacote models.enums, gravados como texto com @Enumerated(STRING))</TD></TR><TR><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>StatusConsulta</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">AGENDADA<BR ALIGN="LEFT"/>CONFIRMADA<BR ALIGN="LEFT"/>EM_ATENDIMENTO<BR ALIGN="LEFT"/>CONCLUIDA<BR ALIGN="LEFT"/>CANCELADA<BR ALIGN="LEFT"/>NAO_COMPARECEU<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+podeMudarPara(novo): boolean<BR ALIGN="LEFT"/>+isFinal(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>StatusEmergencia</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">AGUARDANDO_AVALIACAO<BR ALIGN="LEFT"/>EM_ATENDIMENTO<BR ALIGN="LEFT"/>CONCLUIDO<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+podeMudarPara(novo): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>StatusProcedimento</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">AGENDADO<BR ALIGN="LEFT"/>EM_ANDAMENTO<BR ALIGN="LEFT"/>CONCLUIDO<BR ALIGN="LEFT"/>CANCELADO<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+podeMudarPara(novo): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>Prioridade</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">BAIXA<BR ALIGN="LEFT"/>MODERADA<BR ALIGN="LEFT"/>ALTA<BR ALIGN="LEFT"/>CRITICA<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>TipoCirurgia</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">ELETIVA<BR ALIGN="LEFT"/>URGENCIA<BR ALIGN="LEFT"/>EMERGENCIA<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR><TR><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>Especialidade</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">CARDIOLOGIA<BR ALIGN="LEFT"/>DERMATOLOGIA<BR ALIGN="LEFT"/>GINECOLOGIA<BR ALIGN="LEFT"/>NEUROLOGIA<BR ALIGN="LEFT"/>ORTOPEDIA<BR ALIGN="LEFT"/>PEDIATRIA<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>CategoriaProfissional</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">CLINICO_GERAL<BR ALIGN="LEFT"/>ESPECIALISTA<BR ALIGN="LEFT"/>CIRURGIAO<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>TipoAtendimento</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">ROTINA<BR ALIGN="LEFT"/>ESPECIALIZADA<BR ALIGN="LEFT"/>EMERGENCIA<BR ALIGN="LEFT"/>CIRURGIA<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>TipoQuarto</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">ENFERMARIA   (2 a 6 leitos)<BR ALIGN="LEFT"/>APARTAMENTO  (1 a 2 leitos)<BR ALIGN="LEFT"/>UTI          (1 a 10 leitos)<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+aceitaCapacidade(n: int): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE></TD><TD VALIGN="TOP"><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed"><TR><TD ALIGN="CENTER">«enumeration»<BR/><B>StatusInternacao</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">ATIVA<BR ALIGN="LEFT"/>ALTA<BR ALIGN="LEFT"/></TD></TR></TABLE></TD></TR></TABLE>>];
Prof -> Clinico [dir=back arrowtail=empty arrowhead=none penwidth=1.3];
Prof -> Especialista [dir=back arrowtail=empty arrowhead=none penwidth=1.3];
Prof -> Cirurgiao [dir=back arrowtail=empty arrowhead=none penwidth=1.3];
Atend -> Consulta [dir=back arrowtail=empty arrowhead=none penwidth=1.3];
Atend -> Emerg [dir=back arrowtail=empty arrowhead=none penwidth=1.3];
Atend -> Cirurgia [dir=back arrowtail=empty arrowhead=none penwidth=1.3];
Consulta -> Rotina [dir=back arrowtail=empty arrowhead=none penwidth=1.3];
Consulta -> Especializada [dir=back arrowtail=empty arrowhead=none penwidth=1.3];
Paciente -> Atend [dir=back arrowtail=vee arrowhead=none taillabel="1" headlabel="0..*" label=<paciente>];
Prof -> Atend [dir=back arrowtail=vee arrowhead=none taillabel="0..1" headlabel="0..*" label=<responsável>];
Paciente -> Internacao [dir=back arrowtail=vee arrowhead=none taillabel="1" headlabel="0..*"];
Prof -> Internacao [dir=back arrowtail=vee arrowhead=none taillabel="1" headlabel="0..*" label=<responsável>];
Quarto -> Internacao [dir=back arrowtail=vee arrowhead=none taillabel="1" headlabel="0..*" label=<ocupa>];
Cirurgiao -> Cirurgia [style=dashed dir=back arrowtail=vee arrowhead=none taillabel="1" headlabel="0..*" label=<realiza>];
Paciente -> Historico [arrowhead=odiamond taillabel="1"];
Atend -> Historico [arrowhead=odiamond taillabel="0..*" label=<só concluídos>];
Internacao -> Historico [arrowhead=odiamond taillabel="0..*"];
{rank=same; Quarto; Paciente; Prof;}
Quarto -> Paciente -> Prof [style=invis];
Rotina -> Enums [style=invis]; Especializada -> Enums [style=invis];
legend [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legenda</B></TD></TR><TR><TD WIDTH="26" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid" BORDER="1"> </TD><TD ALIGN="LEFT">Classe implementada no código</TD></TR><TR><TD WIDTH="26" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed" BORDER="1"> </TD><TD ALIGN="LEFT">Classe só documentada no código (a implementar)</TD></TR><TR><TD WIDTH="26" BGCOLOR="#EAF5EA" COLOR="#3C7A3C" STYLE="dashed" BORDER="1"> </TD><TD ALIGN="LEFT">Enum (a implementar)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Nomes em itálico = classes abstratas.</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Seta com triângulo vazio = herança (aponta para a superclasse).</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Getters e setters omitidos. Todos os enums têm descricao + getDescricao().</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">As 3 hierarquias de Atendimento com status usam a mesma coluna "status".</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Associação "realiza" = o profissional de um ProcedimentoCirurgico é um Cirurgiao.</TD></TR></TABLE>>];
Enums -> legend [style=invis];
}
