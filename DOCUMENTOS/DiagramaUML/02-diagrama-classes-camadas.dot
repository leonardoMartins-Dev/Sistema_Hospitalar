digraph G {
  rankdir=LR; splines=true; nodesep=0.55; ranksep=0.9; pad=0.4;
  labelloc=t; fontsize=24; fontname="Helvetica"; label=<<B>MedVita — Diagrama de Classes: Controllers, Services e Repositories (Sprint 2)</B>>;
  node [fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=11 color="#333333" labeldistance=2.2];
  ranksep=1.3; nodesep=0.4; compound=true;
subgraph cluster_ctrl { label=<<B>Camada Controller</B>>; style=rounded; color="#999999"; fontsize=16;
cConsulta [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController» /consultas<BR/><B>ConsultaController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">POST /consultas<BR ALIGN="LEFT"/>GET  /consultas?tipo=<BR ALIGN="LEFT"/>GET  /consultas/{id}<BR ALIGN="LEFT"/>GET  /consultas/minhas<BR ALIGN="LEFT"/>GET  /consultas/agenda?data=<BR ALIGN="LEFT"/>GET  /consultas/profissionais-disponiveis?especialidade=&amp;data=&amp;horario=<BR ALIGN="LEFT"/>PUT  /consultas/{id}/iniciar     (qualquer modalidade)<BR ALIGN="LEFT"/>PUT  /consultas/{id}/concluir    (qualquer modalidade)<BR ALIGN="LEFT"/>PUT  /consultas/{id}/cancelar    (qualquer modalidade)<BR ALIGN="LEFT"/>PUT  /consultas/{id}/confirmar<BR ALIGN="LEFT"/>PUT  /consultas/{id}/nao-compareceu<BR ALIGN="LEFT"/>PUT  /consultas/{id}/encaminhar?especialidade=<BR ALIGN="LEFT"/>POST /consultas/{id}/reagendar<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cEmerg [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController» /consultas<BR/><B>EmergenciaCirurgiaController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">POST /consultas/emergencias<BR ALIGN="LEFT"/>GET  /consultas/emergencias?status=<BR ALIGN="LEFT"/>PUT  /consultas/emergencias/{id}/assumir?profissionalId=<BR ALIGN="LEFT"/>POST /consultas/cirurgias<BR ALIGN="LEFT"/>GET  /consultas/procedimentos?cirurgiaoId=<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>ProfissionalSaudeController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GET    /profissionais?categoria=&amp;especialidade=<BR ALIGN="LEFT"/>GET    /profissionais/especialidades<BR ALIGN="LEFT"/>GET    /profissionais/{id}<BR ALIGN="LEFT"/>POST   /profissionais<BR ALIGN="LEFT"/>DELETE /profissionais/{id}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cPaciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>PacienteController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GET /pacientes?busca=<BR ALIGN="LEFT"/>GET /pacientes/perfil<BR ALIGN="LEFT"/>GET /pacientes/{id}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cInternacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>InternacaoController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">POST /internacoes<BR ALIGN="LEFT"/>GET  /internacoes?status=<BR ALIGN="LEFT"/>GET  /internacoes/minhas<BR ALIGN="LEFT"/>GET  /internacoes/{id}<BR ALIGN="LEFT"/>PUT  /internacoes/{id}/alta<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cQuarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>QuartoController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GET  /quartos?tipo=&amp;disponivel=<BR ALIGN="LEFT"/>GET  /quartos/tipos<BR ALIGN="LEFT"/>GET  /quartos/{id}<BR ALIGN="LEFT"/>POST /quartos<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cHistorico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>HistoricoMedicoController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GET /historico<BR ALIGN="LEFT"/>GET /historico/{pacienteId}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_dto { label=<<B>DTOs (pacote dto)</B>>; style=rounded; color="#999999"; fontsize=16;
dCons [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«record»<BR/><B>ConsultaRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">tipo, pacienteId, profissionalId, data,<BR ALIGN="LEFT"/>horario, motivo, especialidade<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
dEmerg [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«record»<BR/><B>EmergenciaRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">pacienteId, motivo, prioridade<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
dCir [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«record»<BR/><B>CirurgiaRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">pacienteId, cirurgiaoId, data, horario,<BR ALIGN="LEFT"/>descricaoProcedimento, tipoCirurgia,<BR ALIGN="LEFT"/>observacoesPreOperatorias<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
dProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«record»<BR/><B>ProfissionalRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">tipo, nome, registroProfissional, telefone,<BR ALIGN="LEFT"/>email, senha, especialidade, areaCirurgica<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
dInt [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«record»<BR/><B>InternacaoRequest</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">pacienteId, profissionalId, quartoId,<BR ALIGN="LEFT"/>dataEntrada, dataPrevistaAlta, observacoes<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_svc { label=<<B>Camada Service</B>>; style=rounded; color="#999999"; fontsize=16;
sConsulta [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>ConsultaService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+criar(req: ConsultaRequest): Consulta<BR ALIGN="LEFT"/>+iniciar(id)<BR ALIGN="LEFT"/>+concluir(id, observacoes)<BR ALIGN="LEFT"/>+cancelar(id)<BR ALIGN="LEFT"/>+confirmar(id)<BR ALIGN="LEFT"/>+registrarFalta(id)<BR ALIGN="LEFT"/>+reagendar(id, data, horario): Consulta<BR ALIGN="LEFT"/>+encaminhar(id, especialidade, emailMedico)<BR ALIGN="LEFT"/>+buscarPorId(id): Atendimento<BR ALIGN="LEFT"/>+listar(tipo)<BR ALIGN="LEFT"/>+listarDoPaciente(pacienteId)<BR ALIGN="LEFT"/>+agendaDoProfissional(profissionalId, data)<BR ALIGN="LEFT"/>+profissionaisDisponiveis(especialidade, data, horario)<BR ALIGN="LEFT"/>-horarioOcupado(profissionalId, data, horario): boolean<BR ALIGN="LEFT"/>-comoConsulta(a): Consulta<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sEmerg [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>EmergenciaCirurgiaService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+registrarEmergencia(req: EmergenciaRequest)<BR ALIGN="LEFT"/>+assumirEmergencia(id, profissionalId)<BR ALIGN="LEFT"/>+filaEmergencia(status): List&lt;AtendimentoEmergencia&gt;<BR ALIGN="LEFT"/>+agendarCirurgia(req: CirurgiaRequest)<BR ALIGN="LEFT"/>+listarProcedimentosDoCirurgiao(cirurgiaoId)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>ProfissionalSaudeService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cadastrar(req: ProfissionalRequest): ProfissionalSaude<BR ALIGN="LEFT"/>+buscar(categoria, especialidade)<BR ALIGN="LEFT"/>+buscarPorId(id)<BR ALIGN="LEFT"/>+buscarPorEmail(email): Optional&lt;ProfissionalSaude&gt;<BR ALIGN="LEFT"/>+remover(id)   (FK do banco impede se tiver histórico)<BR ALIGN="LEFT"/>+listarEspecialidades()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sPaciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>PacienteService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pacienteRepository: PacienteRepository<BR ALIGN="LEFT"/>-passwordEncoder: PasswordEncoder<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cadastrar(email, senha, nome, cpf, telefone, endereco, dataNascimento)<BR ALIGN="LEFT"/>+existe(email): boolean<BR ALIGN="LEFT"/>+buscarPorEmail(email): Optional&lt;Paciente&gt;<BR ALIGN="LEFT"/>+buscarNome(email): String<BR ALIGN="LEFT"/>+atualizarSenha(email, novaSenha)<BR ALIGN="LEFT"/>+listar() *<BR ALIGN="LEFT"/>+buscar(termo) *<BR ALIGN="LEFT"/>+buscarPorId(id) *<BR ALIGN="LEFT"/>-normalizar(email): String<BR ALIGN="LEFT"/>-somenteDigitos(valor): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sInternacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>InternacaoService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+internar(req: InternacaoRequest): Internacao<BR ALIGN="LEFT"/>+darAlta(id, dataEfetivaAlta, observacoes): Internacao<BR ALIGN="LEFT"/>+buscarPorId(id)<BR ALIGN="LEFT"/>+listar(status)<BR ALIGN="LEFT"/>+listarDoPaciente(pacienteId)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sQuarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>QuartoService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cadastrar(quarto): Quarto<BR ALIGN="LEFT"/>+listar(tipo, disponivel)<BR ALIGN="LEFT"/>+listarDisponiveis()<BR ALIGN="LEFT"/>+buscarPorId(id)<BR ALIGN="LEFT"/>+listarTipos()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sHistorico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>HistoricoMedicoService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+doPaciente(pacienteId): HistoricoMedico<BR ALIGN="LEFT"/>+doPacienteLogado(email): HistoricoMedico<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_repo { label=<<B>Camada Repository</B>>; style=rounded; color="#999999"; fontsize=16;
rAtend [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>AtendimentoRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;Atendimento, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByPacienteIdOrderByDataDescHorarioDesc(pacienteId)<BR ALIGN="LEFT"/>findByProfissionalIdAndDataOrderByHorario(profissionalId, data)<BR ALIGN="LEFT"/>findByProfissionalIdAndDataAndHorario(profissionalId, data, horario)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rEmerg [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>AtendimentoEmergenciaRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;AtendimentoEmergencia, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByStatus(status)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rCir [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>ProcedimentoCirurgicoRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;ProcedimentoCirurgico, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByProfissionalIdOrderByDataDescHorarioDesc(cirurgiaoId)<BR ALIGN="LEFT"/>findByProfissionalIdAndDataAndHorario(cirurgiaoId, data, horario)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>ProfissionalSaudeRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;ProfissionalSaude, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByEmail(email)<BR ALIGN="LEFT"/>existsByEmail(email)<BR ALIGN="LEFT"/>existsByRegistroProfissional(registro)<BR ALIGN="LEFT"/>@Query buscarEspecialistas(especialidade)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rPaciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>PacienteRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;Paciente, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByEmail(email): Optional&lt;Paciente&gt;<BR ALIGN="LEFT"/>existsByEmail(email): boolean<BR ALIGN="LEFT"/>existsByCpf(cpf) *<BR ALIGN="LEFT"/>findByNome...OrCpf...OrEmail...(termo) *<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rInternacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>InternacaoRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;Internacao, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByPacienteIdOrderByDataEntradaDesc(pacienteId)<BR ALIGN="LEFT"/>findByStatusOrderByDataEntradaDesc(status)<BR ALIGN="LEFT"/>existsByPacienteIdAndStatus(pacienteId, status)<BR ALIGN="LEFT"/>existsByQuartoIdAndStatus(quartoId, status)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rQuarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>QuartoRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;Quarto, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">existsByNumero(numero)<BR ALIGN="LEFT"/>findAllByOrderByAndarAscNumeroAsc()<BR ALIGN="LEFT"/>findByTipoOrderByAndarAscNumeroAsc(tipo)<BR ALIGN="LEFT"/>@Query buscarDisponiveis()<BR ALIGN="LEFT"/>@Lock @Query buscarParaAtualizar(id)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_ent { label=<<B>Camada Model (detalhes no diagrama 01)</B>>; style=rounded; color="#999999"; fontsize=16;
eAtend [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«abstract · Entity»<BR/><B><I>Atendimento</I></B><BR/><FONT POINT-SIZE="10">ConsultaRotina, ConsultaEspecializada,<BR/>AtendimentoEmergencia, ProcedimentoCirurgico</FONT></TD></TR></TABLE>>];
eProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«abstract · Entity»<BR/><B><I>ProfissionalSaude</I></B><BR/><FONT POINT-SIZE="10">MedicoClinicoGeral, MedicoEspecialista, Cirurgiao</FONT></TD></TR></TABLE>>];
ePaciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity»<BR/><B>Paciente</B></TD></TR></TABLE>>];
eInternacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity»<BR/><B>Internacao</B></TD></TR></TABLE>>];
eQuarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity»<BR/><B>Quarto</B></TD></TR></TABLE>>];
eHistorico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«não persistida»<BR/><B>HistoricoMedico</B></TD></TR></TABLE>>];
}
cConsulta -> sConsulta [arrowhead=vee];
cEmerg -> sEmerg [arrowhead=vee];
cProf -> sProf [arrowhead=vee];
cPaciente -> sPaciente [arrowhead=vee];
cInternacao -> sInternacao [arrowhead=vee];
cQuarto -> sQuarto [arrowhead=vee];
cHistorico -> sHistorico [arrowhead=vee];
