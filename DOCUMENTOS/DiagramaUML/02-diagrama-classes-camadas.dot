digraph G {
  rankdir=LR; splines=true; nodesep=0.55; ranksep=0.9; pad=0.4;
  labelloc=t; fontsize=24; fontname="DejaVu Sans"; label=<<B>MedVita — Diagrama de Classes: Controllers, Services e Repositories</B>>;
  node [fontname="DejaVu Sans" fontsize=12];
  edge [fontname="DejaVu Sans" fontsize=11 color="#333333" labeldistance=2.2];
  ranksep=1.3; nodesep=0.4; compound=true;
subgraph cluster_ctrl { label=<<B>Camada Controller</B>>; style=rounded; color="#999999"; fontsize=16;
cConsulta [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>ConsultaController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">POST /api/consultas<BR ALIGN="LEFT"/>GET /api/consultas/minhas<BR ALIGN="LEFT"/>GET /api/consultas?data=<BR ALIGN="LEFT"/>PUT /api/consultas/{id}/cancelar<BR ALIGN="LEFT"/>PUT /api/consultas/{id}/realizar<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cHistorico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>HistoricoMedicoController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GET /api/historico<BR ALIGN="LEFT"/>GET /api/historico/{pacienteId}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cInternacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>InternacaoController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">POST /api/internacoes<BR ALIGN="LEFT"/>GET /api/internacoes<BR ALIGN="LEFT"/>GET /api/internacoes/minhas<BR ALIGN="LEFT"/>PUT /api/internacoes/{id}/alta<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cPaciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>PacienteController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GET /api/pacientes?busca=<BR ALIGN="LEFT"/>GET /api/pacientes/{id}<BR ALIGN="LEFT"/>GET /api/pacientes/perfil<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>ProfissionalSaudeController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GET /api/profissionais<BR ALIGN="LEFT"/>GET /api/profissionais?especialidade=<BR ALIGN="LEFT"/>POST /api/profissionais<BR ALIGN="LEFT"/>DELETE /api/profissionais/{id}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cQuarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«RestController»<BR/><B>QuartoController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">GET /api/quartos<BR ALIGN="LEFT"/>GET /api/quartos/disponiveis<BR ALIGN="LEFT"/>POST /api/quartos<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_svc { label=<<B>Camada Service</B>>; style=rounded; color="#999999"; fontsize=16;
sConsulta [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>ConsultaService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+agendar(paciente, profissionalId, data, horario, motivo)<BR ALIGN="LEFT"/>+cancelar(id)<BR ALIGN="LEFT"/>+realizar(id, observacoes)<BR ALIGN="LEFT"/>+listarDoPaciente(pacienteId)<BR ALIGN="LEFT"/>+listarDoProfissional(profissionalId, data)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sHistorico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>HistoricoMedicoService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+doPaciente(pacienteId): HistoricoMedico<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sInternacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>InternacaoService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+internar(pacienteId, profissionalId, quartoId,<BR ALIGN="LEFT"/>        dataEntrada, dataPrevistaAlta, observacoes)<BR ALIGN="LEFT"/>+darAlta(id, dataEfetivaAlta, observacoes)<BR ALIGN="LEFT"/>+listarInternados()<BR ALIGN="LEFT"/>+listarDoPaciente(pacienteId)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sPaciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>PacienteService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">-pacienteRepository: PacienteRepository<BR ALIGN="LEFT"/>-passwordEncoder: PasswordEncoder<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cadastrar(email, senha, nome, cpf, telefone, endereco, dataNascimento)<BR ALIGN="LEFT"/>+existe(email): boolean<BR ALIGN="LEFT"/>+buscarPorEmail(email): Optional&lt;Paciente&gt;<BR ALIGN="LEFT"/>+buscarNome(email): String<BR ALIGN="LEFT"/>+atualizarSenha(email, novaSenha)<BR ALIGN="LEFT"/>+listar() *<BR ALIGN="LEFT"/>+buscar(texto) *<BR ALIGN="LEFT"/>+buscarPorId(id) *<BR ALIGN="LEFT"/>-normalizar(email): String<BR ALIGN="LEFT"/>-somenteDigitos(valor): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>ProfissionalSaudeService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cadastrar(nome, registro, especialidade, telefone, email, senha)<BR ALIGN="LEFT"/>+listar()<BR ALIGN="LEFT"/>+listarPorEspecialidade(especialidade)<BR ALIGN="LEFT"/>+buscarPorId(id)<BR ALIGN="LEFT"/>+buscarPorEmail(email)<BR ALIGN="LEFT"/>+remover(id)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
sQuarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Service»<BR/><B>QuartoService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+cadastrar(numero, andar, capacidadeMaxima)<BR ALIGN="LEFT"/>+listar()<BR ALIGN="LEFT"/>+listarDisponiveis()<BR ALIGN="LEFT"/>+buscarPorId(id)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_repo { label=<<B>Camada Repository</B>>; style=rounded; color="#999999"; fontsize=16;
rConsulta [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>ConsultaRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;Consulta, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">existsByProfissionalIdAndDataAndHorarioAndStatusNot(...)<BR ALIGN="LEFT"/>findByPacienteId(pacienteId)<BR ALIGN="LEFT"/>findByPacienteIdAndStatus(pacienteId, status)<BR ALIGN="LEFT"/>findByProfissionalIdAndData(profissionalId, data)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rInternacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>InternacaoRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;Internacao, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByPacienteId(pacienteId)<BR ALIGN="LEFT"/>findByDataEfetivaAltaIsNull()<BR ALIGN="LEFT"/>existsByPacienteIdAndDataEfetivaAltaIsNull(pacienteId)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rPaciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>PacienteRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;Paciente, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByEmail(email): Optional&lt;Paciente&gt;<BR ALIGN="LEFT"/>existsByEmail(email): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>ProfissionalSaudeRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;ProfissionalSaude, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">findByEmail(email)<BR ALIGN="LEFT"/>existsByEmail(email)<BR ALIGN="LEFT"/>existsByRegistroProfissional(registro)<BR ALIGN="LEFT"/>findByEspecialidade(especialidade)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
rQuarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«interface»<BR/><B>QuartoRepository</B><BR/><FONT POINT-SIZE="10">extends JpaRepository&lt;Quarto, Long&gt;</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">existsByNumero(numero)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_ent { label=<<B>Camada Model</B>>; style=rounded; color="#999999"; fontsize=16;
ePaciente [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity»<BR/><B>Paciente</B></TD></TR></TABLE>>];
eProf [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity»<BR/><B>ProfissionalSaude</B></TD></TR></TABLE>>];
eQuarto [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity»<BR/><B>Quarto</B></TD></TR></TABLE>>];
eConsulta [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity»<BR/><B>Consulta</B></TD></TR></TABLE>>];
eInternacao [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«Entity»<BR/><B>Internacao</B></TD></TR></TABLE>>];
eHistorico [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed"><TR><TD ALIGN="CENTER" CELLPADDING="6">«não persistida»<BR/><B>HistoricoMedico</B></TD></TR></TABLE>>];
}
cConsulta -> sConsulta [arrowhead=vee];
cHistorico -> sHistorico [arrowhead=vee];
cInternacao -> sInternacao [arrowhead=vee];
cPaciente -> sPaciente [arrowhead=vee];
cProf -> sProf [arrowhead=vee];
cQuarto -> sQuarto [arrowhead=vee];
sConsulta -> rConsulta [arrowhead=vee];
sInternacao -> rInternacao [arrowhead=vee];
sInternacao -> rQuarto [arrowhead=vee];
sHistorico -> rConsulta [arrowhead=vee];
sHistorico -> rInternacao [arrowhead=vee];
sPaciente -> rPaciente [arrowhead=vee];
sProf -> rProf [arrowhead=vee];
sQuarto -> rQuarto [arrowhead=vee];
sConsulta -> sProf [style=dashed arrowhead=vee constraint=false];
sConsulta -> sPaciente [style=dashed arrowhead=vee constraint=false];
sInternacao -> sPaciente [style=dashed arrowhead=vee constraint=false];
sInternacao -> sProf [style=dashed arrowhead=vee constraint=false];
sHistorico -> sPaciente [style=dashed arrowhead=vee constraint=false];
rConsulta -> eConsulta [style=dashed arrowhead=vee label=<gerencia>];
rInternacao -> eInternacao [style=dashed arrowhead=vee label=<gerencia>];
rPaciente -> ePaciente [style=dashed arrowhead=vee label=<gerencia>];
rProf -> eProf [style=dashed arrowhead=vee label=<gerencia>];
rQuarto -> eQuarto [style=dashed arrowhead=vee label=<gerencia>];
sHistorico -> eHistorico [style=dashed arrowhead=vee label=<monta>];
legend [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legenda</B></TD></TR><TR><TD WIDTH="26" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid" BORDER="1"> </TD><TD ALIGN="LEFT">Classe implementada no código</TD></TR><TR><TD WIDTH="26" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed" BORDER="1"> </TD><TD ALIGN="LEFT">Classe só documentada no código (a implementar)</TD></TR><TR><TD WIDTH="26" BGCOLOR="#F1F1F1" COLOR="#777777" STYLE="solid" BORDER="1"> </TD><TD ALIGN="LEFT">Classe/interface de framework (Spring, JDK)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">* = método citado na documentação do PacienteController, ainda não existe.</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Setas tracejadas entre services = dependência (usa).</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Relações entre as entidades: ver diagrama 01.</TD></TR></TABLE>>];
legend -> cConsulta [style=invis];
}
