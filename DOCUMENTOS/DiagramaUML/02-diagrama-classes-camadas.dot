cEmerg -> dEmerg [style=dotted arrowhead=vee label=<recebe> constraint=false];
cEmerg -> dCir [style=dotted arrowhead=vee label=<recebe> constraint=false];
cProf -> dProf [style=dotted arrowhead=vee label=<recebe> constraint=false];
cInternacao -> dInt [style=dotted arrowhead=vee label=<recebe> constraint=false];
sConsulta -> rAtend [arrowhead=vee];
sConsulta -> rPaciente [arrowhead=vee];
sConsulta -> rProf [arrowhead=vee];
sEmerg -> rEmerg [arrowhead=vee];
sEmerg -> rCir [arrowhead=vee];
sEmerg -> rPaciente [arrowhead=vee];
sEmerg -> rProf [arrowhead=vee];
sProf -> rProf [arrowhead=vee];
sPaciente -> rPaciente [arrowhead=vee];
sInternacao -> rInternacao [arrowhead=vee];
sInternacao -> rQuarto [arrowhead=vee];
sInternacao -> rPaciente [arrowhead=vee];
sInternacao -> rProf [arrowhead=vee];
sQuarto -> rQuarto [arrowhead=vee];
sHistorico -> rAtend [arrowhead=vee];
sHistorico -> rInternacao [arrowhead=vee];
sHistorico -> rPaciente [arrowhead=vee];
sProf -> sPaciente [style=dashed arrowhead=vee constraint=false];
sConsulta -> sPaciente [style=dashed arrowhead=vee constraint=false];
sInternacao -> sPaciente [style=dashed arrowhead=vee constraint=false];
sHistorico -> sPaciente [style=dashed arrowhead=vee constraint=false];
rAtend -> eAtend [style=dashed arrowhead=vee label=<gerencia>];
rEmerg -> eAtend [style=dashed arrowhead=vee label=<gerencia (subclasse)>];
rCir -> eAtend [style=dashed arrowhead=vee label=<gerencia (subclasse)>];
rProf -> eProf [style=dashed arrowhead=vee label=<gerencia>];
rPaciente -> ePaciente [style=dashed arrowhead=vee label=<gerencia>];
rInternacao -> eInternacao [style=dashed arrowhead=vee label=<gerencia>];
rQuarto -> eQuarto [style=dashed arrowhead=vee label=<gerencia>];
sHistorico -> eHistorico [style=dashed arrowhead=vee label=<monta>];
legend [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#999999"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legenda</B></TD></TR><TR><TD WIDTH="26" BGCOLOR="#E3EEFB" COLOR="#2B5C9E" STYLE="solid" BORDER="1"> </TD><TD ALIGN="LEFT">Classe implementada no código</TD></TR><TR><TD WIDTH="26" BGCOLOR="#FFF4D6" COLOR="#B7791F" STYLE="dashed" BORDER="1"> </TD><TD ALIGN="LEFT">Classe só documentada no código (a implementar)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">* = método documentado no código, ainda não existe.</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Setas tracejadas entre services = usa só o buscarPorEmail, que já existe.</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Os services usam os repositories de outras partes direto, não os services,</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">para uma parte não depender das regras da outra.</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Setas pontilhadas = o controller recebe esse DTO no @RequestBody.</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Endereços exatamente como no PDF (sem /api). Erros: 400, 404, 409.</TD></TR></TABLE>>];
legend -> cConsulta [style=invis];
}
