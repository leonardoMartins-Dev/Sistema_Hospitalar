# Modelo do .env. Copie para ".env" (na pasta MedVita/) e preencha.
# O .env real NÃO vai para o Git.
#
# Com Docker (docker compose up), pode deixar tudo vazio: o banco é o
# Postgres do container e o reCAPTCHA usa as chaves de teste do Google.
# Preencha só o que quiser usar de verdade.
# Sem Docker (mvn spring-boot:run), o reCAPTCHA e o Supabase são obrigatórios.

# =========================================================
# GMAIL (SendEmailService) - só a recuperação de senha usa
# https://myaccount.google.com/apppasswords
# ex.: MAIL_USERNAME=seu-email@gmail.com e MAIL_PASSWORD=sua-senha-de-app
# =========================================================
MAIL_USERNAME=
MAIL_PASSWORD=

# =========================================================
# GOOGLE reCAPTCHA (v2 "Não sou um robô", domínio localhost)
# https://www.google.com/recaptcha/admin
# =========================================================
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# =========================================================
# SUPABASE (PostgreSQL)
# Supabase > Connect > Direct > Session pooler
# ex.: SUPABASE_DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres
#      SUPABASE_DB_USER=postgres.<project-ref>
#      SUPABASE_DB_PASSWORD=sua-senha-do-banco
# =========================================================
SUPABASE_DB_URL=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
